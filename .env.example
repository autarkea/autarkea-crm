# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
# ⚠️ TELEGRAM_USER_ID УСТАРЕЛ! 
# Доступ к боту теперь управляется через таблицу "Сотрудники" в NocoDB.

# ==========================================
# РАССЫЛКИ И НАПОМИНАНИЯ (опционально)
# ==========================================
# Время утренней сводки (cron, время сервера). Дефолт: 0 10 * * *
# ⚠️ v4.28.5: значения с пробелами/звёздочками. НЕ оборачивать в кавычки —
# безопасный загрузчик скриптов (load_env) и dotenv читают их и так.
MORNING_CRON=0 10 * * *
# Частота проверки напоминаний о дедлайнах (cron). Дефолт: */5 * * * *
# v4.27.0 (Проблема 92): раньше */30 давала задержку «пора выполнять» на 15–40 минут.
REMINDER_CRON=*/5 * * * *

# ==========================================
# NOCODB
# ==========================================
# Стандартный внутренний адрес для Docker Compose. 
# Установщик (setup-bot.sh) автоматически адаптирует его при необходимости.
NOCO_URL=http://nocodb:8080
NOCO_TOKEN=your_noco_token_here
BASE_ID=your_base_id_here

# ID таблиц (НЕ ЗАПОЛНЯЙ ВРУЧНУЮ! Заполняются автоматически скриптом setup-bot.sh)
TABLE_TASKS=
TABLE_CONTACTS=
TABLE_PROJECTS=
TABLE_DOCUMENTS=
TABLE_ITEMS=
TABLE_LEGAL_ENTITIES=
TABLE_MY_DETAILS=
TABLE_EMPLOYEES=
TABLE_DOC_SETTINGS=

# ==========================================
# EMAIL (SMTP)
# ==========================================
# Для Gmail: smtp.gmail.com, для cPanel: mail.ваш-домен.by
SMTP_HOST=smtp.gmail.com

# 465 для SSL/TLS (cPanel, Gmail), 587 для STARTTLS
SMTP_PORT=465

# Email для авторизации (обычно совпадает с SMTP_FROM)
SMTP_USER=your_email@gmail.com

# Пароль (для Gmail/Yandex — App Password, не обычный пароль!)
SMTP_PASS=your_app_password

# От чьего имени отправлять письма
SMTP_FROM=your_email@gmail.com

# 🆕 v4.9.0: Тип соединения (true = SSL/TLS на 465, false = STARTTLS на 587)
SMTP_SECURE=true

# 🆕 v4.9.0: Проверка SSL-сертификата (false для cPanel с self-signed сертификатом)
SMTP_REJECT_UNAUTHORIZED=false

# ==========================================
# WEBHOOK
# ==========================================
# Будет автоматически заменен установщиком на реальный IP сервера или Tailscale IP
WEBHOOK_HOST=127.0.0.1
# Заменяется install.sh на случайный (openssl rand -hex 32). Не оставляй плейсхолдер:
# сервисы с пустым/дефолтным секретом закрывают все роуты (fail-closed, v4.27.3).
WEBHOOK_SECRET=your_secret_here

# JWT-секрет NocoDB (генерируется автоматически install.sh, НЕ заполняй вручную).
# Нужен ТОЛЬКО NocoDB для подписи токенов сессий (NC_AUTH_JWT_SECRET в docker-compose.yml).
# Если строки нет в .env — compose подставит публично известный дефолт
# `default_jwt_secret_change_this`, что позволяет подделать сессию админа в UI.
JWT_SECRET=

# ==========================================
# SYSTEM
# ==========================================
TZ=Europe/Minsk

# Версия схемы установленной CRM (управляется modules/version.sh + upgrade.sh,
# источник правды — nc_store, APP_VERSION только для глаза)
APP_VERSION=0.0.0

# Dynamic User IDs (заполняется установщиком автоматически через id -u / id -g)
APP_UID=
APP_GID=

# ==========================================
# BACKUP (резервное копирование, v4.12.0)
# ==========================================
# Сколько ЛОКАЛЬНЫХ бэкапов хранить (ротация, дефолт 7)
BACKUP_RETENTION_LOCAL=7

# Сколько ОБЛАЧНЫХ бэкапов хранить в Google Drive (дефолт 14)
BACKUP_RETENTION_CLOUD=14

# Путь к rclone.conf на хосте (монтируется в контейнер бота для команды /backup,
# v4.33.0, Проблема 108). Заполняется автоматически modules/backup-install.sh
# при настройке облачных бэкапов. Пока не заполнен — docker-compose монтирует
# /dev/null, и бот честно пишет «Облако: не настроено».
# v4.34.0, Проблема 109: в контейнере файл монтируется в /home/node/.config/rclone/rclone.conf
# (home юзера node — процесс бота идёт от user ${APP_UID}, /root ему недоступен).
# RCLONE_CONF=

# ==========================================
# HEALTH-МОНИТОРИНГ (v4.28.2)
# ==========================================
# Порог заполнения диска /mnt/data для алерта Руководителю (в %, дефолт 90).
# При достижении — Telegram-алерт один раз за «инцидент», при снижении — «восстановлен».
DISK_ALERT_PERCENT=90
